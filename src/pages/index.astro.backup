
---
import {
  ArrowDown,
  ArrowRight,
  ArrowUpRight,
  Code,
  ExternalLink,
  GraduationCap,
  Mail,
  MapPin,
  Menu,
  X,
} from "@lucide/astro";
import Github from "../components/Github.astro";
import Linkedin from "../components/Linkedin.astro";

const projects = [
  {
    number: "01",
    title: "GameForge",
    category: "Gaming / Discovery",
    description:
      "A modern game discovery platform for exploring games, genres, platforms, and favourites.",
    stack: ["React", "Vite", "RAWG API"],
    initials: "GF",
    github: "https://github.com/Jwayeye75/gameforge",
    live: "https://gameforge-blond.vercel.app",
  },
  {
    number: "02",
    title: "Apex Cinema",
    category: "Entertainment / Web App",
    description:
      "Discover movies and series, explore trailers, and manage personal watchlists.",
    stack: ["React", "TMDB API", "Supabase"],
    initials: "AC",
    github: "https://github.com/Jwayeye75/my-movie-cave",
    live: "https://my-movie-cave.vercel.app",
  },
  {
    number: "03",
    title: "NaijaFeed",
    category: "News / Editorial",
    description:
      "A Nigerian and global news platform covering technology, business, sports, and culture.",
    stack: ["React", "Vite", "NewsAPI"],
    initials: "NF",
    github: "https://github.com/Jwayeye75/naijafeed",
    live: "https://naijafeed.vercel.app",
  },
  {
    number: "04",
    title: "Debug IQ",
    category: "Developer Tools / AI",
    description:
      "A developer-focused project built with Next.js, Supabase, and Groq integration.",
    stack: ["Next.js", "TypeScript", "Supabase", "Groq"],
    initials: "DI",
    github: "https://github.com/Jwayeye75/debug-iq",
    live: null,
  },
  {
    number: "05",
    title: "Student Result Portal",
    category: "Education / Web Application",
    description:
      "An academic result portal project designed around student and result management.",
    stack: ["Web Application", "Education"],
    initials: "SR",
    github: "https://github.com/Jwayeye75/university-result-portal",
    live: null,
  },
];

const skills = [
  "React",
  "JavaScript",
  "HTML & CSS",
  "Vite",
  "REST APIs",
  "Supabase",
  "Git & GitHub",
  "Responsive Design",
];

const linkedin =
  "https://www.linkedin.com/in/josiah-haruna-ayeye-a23968444/";

const email = "josiahharunaayeye@gmail.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121212" />

    <title>SYNC X â€” Josiah Haruna Ayeye | Full-Stack Developer</title>

    <meta
      name="description"
      content="Portfolio of Josiah Haruna Ayeye, a full-stack developer from Nigeria. Explore selected work, skills, and creative digital experiences."
    />

    <link rel="icon" href="/images/sync-x-logo-orange.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="scroll-progress" aria-hidden="true"></div>

    <!-- NAVIGATION -->
    <header class="site-header">
      <a href="#home" class="brand" aria-label="SYNC X, homepage">
        <img
          src="/images/sync-x-logo-orange.png"
          alt="SYNC X"
          width="180"
          height="48"
