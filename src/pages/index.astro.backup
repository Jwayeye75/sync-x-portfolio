            </p>

            <div class="hero-actions">
              <a href="#work" class="button button-dark">
                Explore My Work
                <ArrowUpRight size={19} stroke-width={2} />
              </a>

              <a href="#about" class="text-link">
                About Me
                <ArrowRight size={18} />
              </a>
            </div>

            <div class="hero-bottom-note">
              <span class="small-rule"></span>
              <span>DESIGN. DEVELOP. DELIVER.</span>
            </div>
          </div>
        </div>

        <!-- Your edited corporate portrait -->
        <div class="hero-portrait">
          <img
            src="/images/josiah-hero.webp"
            alt="Josiah Haruna Ayeye wearing a black blazer and sunglasses"
            width="1200"
            height="1173"
            fetchpriority="high"
          />
        </div>

        <div class="hero-right">
          <div class="hero-aside">
            <div class="availability">
              <span class="availability-label">
                <span class="status-dot"></span>
                AVAILABLE FOR
              </span>

              <h2>
                Freelance &<br />
                Full-Time Work
              </h2>

              <p>
                Open to exciting opportunities and meaningful
                collaborations.
              </p>
            </div>

            <div class="hero-socials">
              <a
                href="https://github.com/Jwayeye75"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub profile"
              >
                <Github size={21} stroke-width={1.8} />
              </a>

              <a
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn profile"
              >
                <Linkedin size={21} stroke-width={1.8} />
              </a>

              <a href={`mailto:${email}`} aria-label="Send an email">
                <Mail size={21} stroke-width={1.8} />
              </a>
            </div>

            <div class="hero-fact-card">
              <div>
                <strong>05</strong>
                <span>Featured Projects</span>
              </div>

              <span class="fact-divider"></span>

              <div>
                <MapPin size={24} stroke-width={1.5} />
                <span>Based in Nigeria</span>
              </div>
            </div>
          </div>

          <a href="#work" class="scroll-cue">
            SCROLL TO EXPLORE
            <ArrowDown size={16} />
          </a>
        </div>
      </section>

      <!-- WORK -->
      <section class="section work-section" id="work">
        <div class="section-container">
          <div class="section-heading">
            <div>
              <span class="section-kicker">
                <span class="orange-dot"></span>
                01 / PORTFOLIO
              </span>

              <h2>SELECTED <em>WORK.</em></h2>
            </div>

            <p>
              A selection of things I've built, combining useful
              functionality with memorable digital experiences.
            </p>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card">
                <div class="project-cover">
                  <span class="project-cover-label">{project.category}</span>
                  <span class="project-initials" aria-hidden="true">
                    {project.initials}
                  </span>
                  <span class="project-cover-number">{project.number} / 05</span>
                </div>

                <div class="project-information">
                  <div class="project-title-row">
                    <h3>{project.title}</h3>
                    <a
                      href={project.github}
                      target="_blank"
