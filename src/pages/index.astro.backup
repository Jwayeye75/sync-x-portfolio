                      aria-label={`View ${project.title} on GitHub`}
                      class="project-arrow"
                    >
                      <ArrowUpRight size={20} stroke-width={1.8} />
                    </a>
                  </div>

                  <p>{project.description}</p>

                  <div class="project-tags">
                    {project.stack.map((tech) => (
                      <span class="tech-tag">{tech}</span>
                    ))}
                  </div>

                  <div class="project-links">
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Github size={16} />
                      Source Code
                    </a>

                    {project.live && (
                      <a
                        href={project.live}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <ExternalLink size={16} />
                        Live Website
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <a
            class="more-projects"
            href="https://github.com/Jwayeye75"
            target="_blank"
            rel="noopener noreferrer"
          >
            More Projects on GitHub
            <ArrowUpRight size={19} />
          </a>
        </div>
      </section>

      <!-- ABOUT -->
      <section class="section about-section" id="about">
        <div class="section-container about-layout">
          <div class="about-left">
            <span class="section-kicker">
              <span class="orange-dot"></span>
              02 / ABOUT ME
            </span>

            <h2>
              MORE THAN<br />
              JUST <em>CODE.</em>
            </h2>

            <div class="about-identity">
              <span class="identity-mark">JA.</span>

              <div>
                <strong>Josiah Haruna Ayeye</strong>
                <span>Full-Stack Developer</span>
              </div>
            </div>
          </div>

          <div class="about-right">
            <p class="about-lead">
              I'm a developer who enjoys transforming
              <span>ideas into meaningful digital products.</span>
            </p>

            <p>
              I'm a Computer Science graduate based in Nigeria,
              passionate about creating responsive, intuitive, and
              functional applications.
            </p>

            <p>
              From building game discovery platforms to modern web
              applications, I enjoy combining clean interfaces with
              the technologies that bring them to life.
            </p>

            <div class="education-card">
              <div class="education-icon">
                <GraduationCap size={24} stroke-width={1.6} />
              </div>

              <div>
                <span class="education-label">EDUCATION</span>
                <strong>B.Sc. Computer Science</strong>
                <span>Federal University Gashua Â· Class of 2026</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section class="section skills-section" id="skills">
        <div class="section-container">
          <div class="section-heading">
            <div>
              <span class="section-kicker">
                <span class="orange-dot"></span>
                03 / TECHNOLOGIES
              </span>

              <h2>MY <em>TOOLKIT.</em></h2>
            </div>

            <p>
              Technologies and tools I use to design, develop, and
              ship digital experiences.
            </p>
          </div>

          <div class="skills-panel">
            <div class="skills-panel-header">
              <Code size={25} stroke-width={1.5} />
              <span>TECHNICAL SKILLS</span>
            </div>

            <div class="skills-list">
              {skills.map((skill) => (
                <span class="skill-pill">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section contact-section" id="contact">
        <div class="section-container">
          <span class="section-kicker">
            <span class="orange-dot"></span>
            04 / GET IN TOUCH
          </span>

          <h2>
            HAVE AN IDEA?<br />
            <em>LET'S BUILD IT.</em>
          </h2>

          <p>
            I'm available for freelance projects, full-time roles,
            and exciting collaborations.
          </p>

          <a href={`mailto:${email}`} class="button contact-button">
            <Mail size={20} />
            Let's Work Together
            <ArrowUpRight size={20} />
          </a>

          <div class="contact-link-row">
            <a href="https://github.com/Jwayeye75" target="_blank" rel="noopener noreferrer">
              GitHub <ArrowUpRight size={16} />
            </a>
            <a href={linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn <ArrowUpRight size={16} />
            </a>
            <a href={`mailto:${email}`}>
              Email <ArrowUpRight size={16} />
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <a href="#home" class="footer-brand">SYNC <span>X</span></a>

      <span>Â© 2026 Josiah Haruna Ayeye</span>

      <a href="#home">
        Back to Top
        <ArrowUpRight size={16} />
      </a>
    </footer>

    <script>
      const menuButton =
        document.querySelector<HTMLButtonElement>("[data-menu-button]");

      const mobileNav =
        document.querySelector<HTMLElement>("[data-mobile-nav]");

      function setMenuOpen(isOpen: boolean) {
        if (!menuButton || !mobileNav) return;

        menuButton.classList.toggle("is-open", isOpen);
        mobileNav.classList.toggle("is-open", isOpen);

        menuButton.setAttribute("aria-expanded", String(isOpen));
        menuButton.setAttribute(
          "aria-label",
          isOpen ? "Close navigation menu" : "Open navigation menu"
        );
      }

      menuButton?.addEventListener("click", () => {
        const isOpen =
          menuButton.getAttribute("aria-expanded") !== "true";

        setMenuOpen(isOpen);
      });

      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenuOpen(false);
      });

      function updateScrollState() {
        const availableScroll =
          document.documentElement.scrollHeight - window.innerHeight;

        const progress =
          availableScroll > 0
            ? (window.scrollY / availableScroll) * 100
            : 0;

        document.documentElement.style.setProperty(
          "--scroll-progress",
          `${progress}%`
        );

        document.body.classList.toggle(
          "scrolled",
          window.scrollY > 40
        );
      }

      window.addEventListener("scroll", updateScrollState, {
        passive: true,
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 760) setMenuOpen(false);
        updateScrollState();
      });

      updateScrollState();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --orange: #e95a19;
    --orange-bright: #ff762b;
    --cream: #f5f1e9;
    --black: #121212;
    --surface: #1e1e1e;
    --border: #303030;
    --muted: #aaa8a4;
    --scroll-progress: 0%;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  body {
    margin: 0;
    background: var(--black);
    color: #f7f5f1;
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  body,
  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button,
  a {
    touch-action: manipulation;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--orange-bright);
    outline-offset: 4px;
  }

  img {
    display: block;
    max-width: 100%;
  }

  ::selection {
    background: var(--orange);
    color: white;
  }

  .scroll-progress {
    position: fixed;
    left: 0;
    top: 0;
    width: var(--scroll-progress);
    height: 3px;
    z-index: 200;
    background: var(--orange-bright);
    pointer-events: none;
  }

  /* NAVIGATION */

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    height: 92px;
    padding: 0 clamp(24px, 5vw, 86px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.3s, height 0.3s;
  }

  body.scrolled .site-header {
    height: 76px;
    background: rgba(18, 18, 18, 0.96);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .brand {
    position: relative;
    z-index: 4;
    width: 185px;
    display: flex;
    align-items: center;
  }

  .brand img {
    width: 100%;
    height: auto;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.6vw, 42px);
    padding: 12px 22px;
    margin-left: auto;
    margin-right: 44px;
  }

  .desktop-nav a {
    color: #24211e;
    font-size: 12px;
    font-weight: 700;
    transition: color 0.2s;
  }

  .desktop-nav a:hover {
    color: var(--orange);
  }

  body.scrolled .desktop-nav a {
    color: #ddd;
  }

  body.scrolled .desktop-nav a:hover {
    color: var(--orange-bright);
  }

  .header-contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 19px;
    color: white;
    background: var(--black);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    transition: background 0.25s, transform 0.25s;
  }

  .header-contact:hover {
    background: var(--orange);
    transform: translateY(-2px);
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  /* HERO */

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 52% 48%;
    min-height: 780px;
    height: min(850px, 100svh);
    overflow: hidden;
  }

  .hero-left {
    background: var(--orange);
    display: flex;
    align-items: center;
    padding: 110px 5vw 70px;
  }

  .hero-left::after {
    content: "";
    position: absolute;
    left: 25%;
    bottom: -170px;
    width: 470px;
    height: 470px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 620px;
    width: 100%;
  }

  .eyebrow,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 2.6px;
    font-size: 10px;
    font-weight: 800;
  }

  .hero-eyebrow {
    color: #fff4e8;
    margin-bottom: 27px;
  }

  .eyebrow-line {
    width: 29px;
    height: 2px;
    background: white;
  }

  .hero-title,
  .section h2 {
    font-family: "Barlow Condensed", Impact, sans-serif;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .hero-title {
    margin: 0 0 30px;
    font-size: clamp(86px, 11vw, 170px);
    color: white;
  }

  .hero-title > span {
    display: block;
  }

  .hero-period {
    color: #241914;
  }

  .hero-description {
    max-width: 310px;
    margin: 0;
    color: #fff3eb;
    font-size: 15px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 800;
    transition: transform 0.25s, background 0.25s;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button-dark {
    color: white;
    background: var(--black);
  }

  .button-dark:hover {
    background: #29221e;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    font-weight: 800;
    color: white;
    min-height: 44px;
  }

  .hero-bottom-note {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 80px;
    color: rgba(255, 255, 255, 0.83);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .small-rule {
    width: 28px;
    height: 1px;
    background: white;
  }

  .hero-portrait {
    position: absolute;
    z-index: 3;
    left: 52%;
    bottom: -2px;
    width: min(58vw, 760px);
    height: 86%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    align-items: end;
    pointer-events: none;
  }

  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(-18px 6px 24px rgba(0, 0, 0, 0.08));
  }

  .hero-right {
    background: var(--cream);
    color: var(--black);
    padding: 180px 5vw 80px 20px;
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .hero-aside {
    position: relative;
    z-index: 4;
    width: min(100%, 215px);
  }

  .availability-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #8c6253;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.6px;
  }

  .status-dot,
  .orange-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: var(--orange);
  }

  .availability h2 {
    margin: 19px 0 13px;
    font-family: "DM Sans", sans-serif;
    font-size: clamp(21px, 2vw, 28px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    text-transform: none;
  }

  .availability p {
    font-size: 13px;
    line-height: 1.7;
    color: #625d59;
  }

  .hero-socials {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 24px;
  }

  .hero-socials a {
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    background: #fffaf4;
    border: 1px solid #e5ded4;
