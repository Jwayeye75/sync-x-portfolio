
---
import {
  ArrowUpRight,
  CalendarDays,
  Globe,
  Trophy,
  Medal,
} from "@lucide/astro";
import Github from "./Github.astro";

const technologies = [
  { name: "React", type: "Frontend", icon: "react/react-original.svg" },
  { name: "Next.js", type: "Full-stack", icon: "nextjs/nextjs-original.svg" },
  { name: "TypeScript", type: "Language", icon: "typescript/typescript-original.svg" },
  { name: "JavaScript", type: "Language", icon: "javascript/javascript-original.svg" },
  { name: "Supabase", type: "Backend & Database", icon: "supabase/supabase-original.svg" },
  { name: "Tailwind CSS", type: "Styling", icon: "tailwindcss/tailwindcss-original.svg" },
  { name: "Vite", type: "Build Tool", icon: "vitejs/vitejs-original.svg" },
  { name: "Node.js", type: "Runtime", icon: "nodejs/nodejs-original.svg" },
  { name: "HTML5", type: "Markup", icon: "html5/html5-original.svg" },
  { name: "CSS3", type: "Styling", icon: "css3/css3-original.svg" },
  { name: "Git", type: "Version Control", icon: "git/git-original.svg" },
  { name: "Astro", type: "Web Framework", icon: "astro/astro-original.svg" },
];
---

<!-- CURRENTLY BUILDING -->
<section class="px-building" id="building">
  <div class="px-container">
    <div class="px-kicker">
      <span class="px-kicker-line"></span>
      03 / CURRENT FOCUS
    </div>

    <div class="px-building-grid">
      <div class="px-building-copy">
        <div class="px-status">
          <span class="px-status-light"></span>
          IN DEVELOPMENT
        </div>

        <h2 class="px-large-title">
          NOW<br />
          <span>BUILDING.</span>
        </h2>

        <div class="px-product-name">
          SYNC <span>X</span>
        </div>

        <p class="px-product-type">
          TOURNAMENT MANAGEMENT PLATFORM
        </p>

        <p class="px-building-description">
          I'm designing and developing SYNC X, a tournament
          management platform for esports and traditional sports.
          The goal is to make organizing competitions, managing
          teams and sharing tournament information easier.
        </p>

        <p class="px-planned-label">
          PLANNED PLATFORM CAPABILITIES
        </p>

        <div class="px-feature-list">
          <div>
            <Trophy size={18} stroke-width={1.7} />
            Tournament & league management
          </div>
          <div>
            <CalendarDays size={18} stroke-width={1.7} />
            Fixtures & scheduling
          </div>
          <div>
            <Globe size={18} stroke-width={1.7} />
            Shareable public standings
          </div>
          <div>
            <Medal size={18} stroke-width={1.7} />
            Winner certificates & exports
          </div>
        </div>

        <a class="px-building-cta" href="#contact">
          Discuss This Project
          <ArrowUpRight size={19} stroke-width={1.8} />
        </a>
      </div>

      <!-- Decorative interface concept, not a live product screenshot -->
      <div class="px-concept" aria-hidden="true">
        <div class="px-concept-top">
          <span class="px-concept-logo">SYNC <b>X</b></span>
          <span class="px-concept-pill">CONCEPT</span>
        </div>

        <div class="px-concept-content">
          <span class="px-concept-overline">
            TOURNAMENT WORKSPACE
          </span>

          <h3>Competition Control</h3>

          <div class="px-concept-tabs">
            <span class="active">Overview</span>
            <span>Fixtures</span>
            <span>Standings</span>
          </div>

          <div class="px-concept-panel">
            <div class="px-concept-panel-header">
              <strong>Competition Setup</strong>
              <span>01 / 03</span>
            </div>

            <div class="px-progress-track">
              <div class="px-progress-fill"></div>
            </div>

            <div class="px-concept-rows">
              <div>
                <span class="px-mini-icon">01</span>
                <span>Teams & participants</span>
                <b>SETUP</b>
              </div>
              <div>
                <span class="px-mini-icon">02</span>
                <span>Fixtures & brackets</span>
                <b>PLAN</b>
              </div>
              <div>
                <span class="px-mini-icon">03</span>
                <span>Results & standings</span>
                <b>TRACK</b>
              </div>
            </div>
          </div>

          <div class="px-concept-bottom">
            <span>ESPORTS + SPORTS</span>
            <span>BUILT FOR COMPETITION</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TECHNOLOGY STACK -->
<section class="px-stack-section" id="skills">
  <div class="px-container">
    <div class="px-kicker">
      <span class="px-kicker-line"></span>
      04 / TECHNOLOGIES
    </div>

    <div class="px-section-heading">
      <h2 class="px-large-title">
        MY <span>TOOLKIT.</span>
      </h2>

      <p>
        Languages, frameworks, and tools I use to turn
        ideas into modern digital experiences.
      </p>
    </div>

    <div class="px-tech-grid">
      {technologies.map((technology) => (
        <div class="px-tech-card">
          <div class="px-tech-icon">
            <img
              src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${technology.icon}`}
              alt=""
              width="43"
              height="43"
              loading="lazy"
              decoding="async"
            />
          </div>

          <strong>{technology.name}</strong>
          <span>{technology.type}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- REAL GITHUB ACTIVITY -->
<section class="px-github-section" id="activity">
  <div class="px-container">
    <div class="px-kicker">
      <span class="px-kicker-line"></span>
      05 / OPEN SOURCE & ACTIVITY
    </div>

    <div class="px-section-heading">
      <div>
        <h2 class="px-large-title">
          ON <span>GITHUB.</span>
        </h2>

        <p class="px-github-description">
          A live look at recent public repository updates.
          Explore the code behind what I've been building.
        </p>
      </div>

      <a
        href="https://github.com/Jwayeye75"
        class="px-profile-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Github size={19} />
        View GitHub Profile
        <ArrowUpRight size={17} stroke-width={1.8} />
      </a>
    </div>

    <div
      class="px-repo-grid"
      id="px-github-repos"
      aria-live="polite"
      aria-busy="true"
    >
      <p class="px-loading">
        Loading public repository activity...
      </p>
    </div>

    <div class="px-github-footer">
      <span>
        Data from GitHub's public API. Private repository
        activity is not included.
      </span>

      <a
        href="https://github.com/Jwayeye75?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
      >
        All Repositories
        <ArrowUpRight size={17} />
      </a>
    </div>
  </div>
</section>

<script>
  interface PublicRepo {
    name: string;
    description: string | null;
    html_url: string;
    language: string | null;
    pushed_at: string | null;
    fork: boolean;
    archived: boolean;
  }

  async function loadGithubActivity() {
    const container = document.getElementById("px-github-repos");

    if (!container) return;

    const showError = () => {
      container.replaceChildren();

      const message = document.createElement("p");
      message.className = "px-loading";
      message.textContent =
        "Recent repository activity is temporarily unavailable. Visit my GitHub profile to explore my work.";

      container.appendChild(message);
      container.setAttribute("aria-busy", "false");
    };

    try {
      const response = await fetch(
        "https://api.github.com/users/Jwayeye75/repos?per_page=100&sort=pushed&type=owner",
        {
          headers: {
            Accept: "application/vnd.github+json",
          },
        }
      );

      if (!response.ok) throw new Error("GitHub API unavailable");

      const allRepos = (await response.json()) as PublicRepo[];

      if (!Array.isArray(allRepos)) {
        throw new Error("Invalid GitHub response");
      }

      const repos = allRepos
        .filter(
          (repo) =>
            !repo.fork &&
            !repo.archived &&
            repo.html_url.startsWith("https://github.com/Jwayeye75/")
        )
        .sort(
          (a, b) =>
            new Date(b.pushed_at ?? 0).getTime() -
            new Date(a.pushed_at ?? 0).getTime()
        )
        .slice(0, 4);

      if (!repos.length) {
        showError();
        return;
      }

      container.replaceChildren();

      const dateFormatter = new Intl.DateTimeFormat("en", {
        day: "numeric",
        month: "short",
        year: "numeric",
      });

      repos.forEach((repo, index) => {
        const card = document.createElement("a");
        card.className = "px-repo-card";
        card.href = repo.html_url;
        card.target = "_blank";
        card.rel = "noopener noreferrer";

        const top = document.createElement("div");
        top.className = "px-repo-top";

        const number = document.createElement("span");
        number.textContent = String(index + 1).padStart(2, "0");

        const arrow = document.createElement("span");
        arrow.className = "px-repo-arrow";
        arrow.textContent = "↗";
        arrow.setAttribute("aria-hidden", "true");

        top.append(number, arrow);

        const title = document.createElement("strong");
        title.className = "px-repo-name";
        title.textContent = repo.name.replace(/[-_]/g, " ");

        const description = document.createElement("p");
        description.className = "px-repo-description";
        description.textContent =
          repo.description || "Explore this project and its source code.";

        const footer = document.createElement("div");
        footer.className = "px-repo-footer";

        const language = document.createElement("span");
        language.textContent = repo.language || "Repository";

        const update = document.createElement("span");

        const pushed = repo.pushed_at
          ? new Date(repo.pushed_at)
          : null;

        update.textContent =
          pushed && !Number.isNaN(pushed.getTime())
            ? `Pushed ${dateFormatter.format(pushed)}`
            : "View on GitHub";

        footer.append(language, update);
        card.append(top, title, description, footer);
        container.appendChild(card);
      });

      container.setAttribute("aria-busy", "false");
    } catch (error) {
      console.warn("GitHub activity unavailable:", error);
      showError();
    }
  }

  loadGithubActivity();
</script>

<style is:global>
  /* COMMON */

  .px-building,
  .px-stack-section,
  .px-github-section {
    padding: 105px 5%;
    font-family: "DM Sans", sans-serif;
  }

  .px-container {
    width: 100%;
    max-width: 1340px;
    margin: auto;
  }

  .px-kicker {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 26px;
    color: #ff762b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2.2px;
  }

  .px-kicker-line {
    width: 26px;
    height: 2px;
    background: #e95a19;
  }

  .px-large-title {
    margin: 0;
    font-family: "Barlow Condensed", Impact, sans-serif;
    font-size: clamp(65px, 8vw, 110px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .px-large-title span {
    color: #e95a19;
  }

  .px-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    margin-bottom: 38px;
  }

  .px-section-heading > p,
  .px-section-heading > div > p {
    color: #aaa;
    max-width: 370px;
    margin: 18px 0 0;
    line-height: 1.8;
    font-size: 14px;
  }

  /* CURRENTLY BUILDING */

  .px-building {
    background: #191919;
    color: #f5f1e9;
  }

  .px-building-grid {
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: 8%;
    align-items: center;
  }

  .px-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px;
    border: 1px solid rgba(233, 90, 25, 0.35);
    border-radius: 100px;
    background: rgba(233, 90, 25, 0.08);
    color: #ff8b4d;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.3px;
    margin-bottom: 28px;
  }

  .px-status-light {
    width: 7px;
    height: 7px;
    background: #ff762b;
    border-radius: 50%;
    box-shadow: 0 0 12px rgba(255, 118, 43, 0.7);
  }

  .px-product-name {
    margin-top: 34px;
    font-size: clamp(36px, 5vw, 65px);
    font-weight: 900;
    letter-spacing: -3px;
    line-height: 1;
  }

  .px-product-name span {
    color: #e95a19;
  }

  .px-product-type {
    color: #ff762b;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 800;
    margin: 12px 0 20px;
  }

  .px-building-description {
    max-width: 510px;
    color: #b5b1ad;
    font-size: 14px;
    line-height: 1.9;
  }

  .px-planned-label {
    margin: 29px 0 16px;
    color: #888;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
  }

  .px-feature-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 18px;
    margin-bottom: 32px;
  }

  .px-feature-list > div {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    line-height: 1.5;
    color: #e5e1dc;
  }

  .px-feature-list svg {
    color: #ff762b;
    flex-shrink: 0;
  }

  .px-building-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 49px;
    padding: 0 21px;
    border-radius: 100px;
    background: #e95a19;
    color: white;
    font-size: 12px;
    font-weight: 800;
    transition: transform 0.25s, background 0.25s;
  }

  .px-building-cta:hover {
    background: #ff762b;
    transform: translateY(-2px);
  }

  /* SYNC X CONCEPT WINDOW */

  .px-concept {
    background: #101010;
    border: 1px solid #3a3a3a;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 35px 85px rgba(0, 0, 0, 0.35);
    transform: rotate(1deg);
    transition: transform 0.4s;
  }

  .px-concept:hover {
    transform: rotate(0deg) translateY(-5px);
  }

  .px-concept-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 20px 23px;
    border-bottom: 1px solid #303030;
  }

  .px-concept-logo {
    font-weight: 900;
    font-size: 17px;
    letter-spacing: -0.5px;
  }

  .px-concept-logo b {
    color: #e95a19;
  }

  .px-concept-pill {
    color: #ff762b;
    background: #332116;
    border: 1px solid #5a3320;
    border-radius: 100px;
    padding: 7px 11px;
    font-size: 9px;
    letter-spacing: 1.3px;
    font-weight: 800;
  }

  .px-concept-content {
    padding: 28px 25px 26px;
  }

  .px-concept-overline {
    color: #888;
    font-size: 9px;
    letter-spacing: 1.8px;
    font-weight: 800;
  }

  .px-concept-content h3 {
    font-size: 23px;
    margin: 11px 0 25px;
    color: white;
  }

  .px-concept-tabs {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid #343434;
  }

  .px-concept-tabs span {
    padding-bottom: 12px;
    font-size: 11px;
    font-weight: 700;
    color: #858585;
  }

  .px-concept-tabs .active {
    color: #ff762b;
    border-bottom: 2px solid #e95a19;
  }

  .px-concept-panel {
    background: #1c1c1c;
    border: 1px solid #383838;
    border-radius: 14px;
    padding: 21px;
  }

  .px-concept-panel-header {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 12px;
    color: #f3f3f3;
  }

  .px-concept-panel-header span {
    color: #999;
    font-size: 10px;
  }

  .px-progress-track {
    height: 5px;
    margin: 18px 0 21px;
    border-radius: 20px;
    background: #3b3b3b;
    overflow: hidden;
  }

  .px-progress-fill {
    height: 100%;
    width: 36%;
    background: #e95a19;
  }

  .px-concept-rows {
    display: grid;
    gap: 10px;
  }

  .px-concept-rows > div {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #272727;
    border-radius: 9px;
    padding: 13px 11px;
    color: #dedede;
    font-size: 11px;
  }

  .px-mini-icon {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 8px;
    background: #39302a;
    color: #ff762b;
    font-size: 10px;
    font-weight: 800;
  }

  .px-concept-rows > div > span:nth-child(2) {
    flex: 1;
  }

  .px-concept-rows b {
    font-size: 9px;
    color: #888;
    letter-spacing: 1px;
  }

  .px-concept-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    color: #777;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.1px;
  }

  /* TECH STACK */

  .px-stack-section {
    background: #121212;
    color: white;
  }

  .px-tech-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 13px;
  }

  .px-tech-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 25px;
    border: 1px solid #333;
    border-radius: 16px;
    background: #1e1e1e;
    transition: transform 0.25s, border-color 0.25s;
  }

  .px-tech-card:hover {
    transform: translateY(-4px);
    border-color: #e95a19;
  }

  .px-tech-icon {
    width: 57px;
    height: 57px;
    display: grid;
    place-items: center;
    margin-bottom: 23px;
    background: #f2f0eb;
    border-radius: 13px;
  }

  .px-tech-icon img {
    width: 39px;
    height: 39px;
    object-fit: contain;
  }

  .px-tech-card strong {
    font-size: 16px;
    margin-bottom: 7px;
    color: #fff;
  }

  .px-tech-card > span {
    font-size: 11px;
    color: #939393;
  }

  /* GITHUB SECTION */

  .px-github-section {
    background: #191919;
    color: white;
  }

  .px-profile-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-weight: 700;
    font-size: 12px;
    min-height: 44px;
  }

  .px-profile-link:hover {
    color: #ff762b;
  }

  .px-repo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 17px;
    min-height: 150px;
  }

  .px-repo-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid #383838;
    background: #212121;
    border-radius: 16px;
    transition: transform 0.25s, border-color 0.25s;
  }

  .px-repo-card:hover {
    transform: translateY(-4px);
    border-color: #e95a19;
  }

  .px-repo-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #ff762b;
    font-size: 11px;
    font-weight: 800;
    margin-bottom: 23px;
  }

  .px-repo-arrow {
    font-size: 24px;
    line-height: 1;
  }

  .px-repo-name {
    font-size: 20px;
    color: #fff;
    letter-spacing: -0.5px;
    text-transform: capitalize;
  }

  .px-repo-description {
    color: #a6a6a6;
    font-size: 12px;
    line-height: 1.8;
    margin: 13px 0 23px;
    flex: 1;
  }

  .px-repo-footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    border-top: 1px solid #383838;
    padding-top: 16px;
    font-size: 10px;
    color: #a5a5a5;
  }

  .px-repo-footer span:first-child {
    color: #ff762b;
  }

  .px-loading {
    grid-column: 1 / -1;
    padding: 24px;
    background: #212121;
    border-radius: 14px;
    color: #aaa;
    font-size: 13px;
    line-height: 1.8;
  }

  .px-github-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-top: 1px solid #363636;
    margin-top: 32px;
    padding-top: 22px;
    color: #999;
    font-size: 11px;
    line-height: 1.6;
  }

  .px-github-footer a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: white;
    white-space: nowrap;
  }

  .px-github-footer a:hover {
    color: #ff762b;
  }

  /* RESPONSIVE */

  @media (max-width: 1000px) {
    .px-building-grid {
      gap: 5%;
    }

    .px-tech-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .px-building,
    .px-stack-section,
    .px-github-section {
      padding: 76px 22px;
    }

    .px-large-title {
      font-size: clamp(64px, 14vw, 93px);
    }

    .px-building-grid {
      grid-template-columns: 1fr;
      gap: 43px;
    }

    .px-feature-list {
      gap: 16px;
    }

    .px-concept {
      transform: none;
    }

    .px-section-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .px-tech-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 11px;
    }

    .px-tech-card {
      padding: 18px;
    }

    .px-tech-icon {
      width: 52px;
      height: 52px;
      margin-bottom: 18px;
