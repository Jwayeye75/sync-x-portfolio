
---
import { ArrowUpRight, ExternalLink, ArrowRight } from "@lucide/astro";
import Github from "./Github.astro";

const projects = [
  {
    number: "01",
    name: "GameForge",
    category: "Gaming & Discovery",
    description:
      "A modern game discovery platform where users can explore games, browse genres and platforms, discover new titles, and manage favourites.",
    technologies: ["React", "Vite", "RAWG API", "CSS"],
    live: "https://gameforge-blond.vercel.app",
    github: "https://github.com/Jwayeye75/gameforge",
  },
  {
    number: "02",
    name: "Apex Cinema",
    category: "Entertainment Platform",
    description:
      "A movie and television discovery experience featuring movie details, trailers, personal watchlists, ratings, and Supabase-powered functionality.",
    technologies: ["React", "TMDB API", "Supabase", "Vite"],
    live: "https://my-movie-cave.vercel.app",
    github: "https://github.com/Jwayeye75/my-movie-cave",
  },
  {
    number: "03",
    name: "NaijaFeed",
    category: "News & Media",
    description:
      "A digital news platform covering Nigerian and international stories across technology, business, politics, entertainment, and culture.",
    technologies: ["React", "Vite", "NewsAPI"],
    live: "https://naijafeed.vercel.app",
    github: "https://github.com/Jwayeye75/naijafeed",
  },
  {
    number: "04",
    name: "Debug IQ",
    category: "AI & Developer Tools",
    description:
      "An AI-powered debugging application that helps developers identify errors, understand code issues, generate suggested fixes, and save debugging sessions.",
    technologies: ["Next.js", "TypeScript", "Groq", "Supabase"],
    live: "https://debug-iq-nine.vercel.app",
    github: "https://github.com/Jwayeye75/debug-iq",
  },
  {
    number: "05",
    name: "Student Result Portal",
    category: "Education Technology",
    description:
      "An academic management platform featuring student records, course management, result uploads, role-based dashboards, and performance reporting.",
    technologies: ["Next.js", "Supabase", "Recharts", "TypeScript"],
    live: "https://university-result-portal.vercel.app",
    github: "https://github.com/Jwayeye75/university-result-portal",
  },
];
---

<section class="sx-work" id="work" aria-labelledby="sx-work-title">
  <div class="sx-container">

    <div class="sx-heading">
      <div>
        <span class="sx-eyebrow">
          <span class="sx-dot"></span>
          01 / MY PORTFOLIO
        </span>

        <h2 id="sx-work-title">
          SELECTED <span>WORK.</span>
        </h2>

        <p class="sx-intro">
          A selection of digital products I've built,
          combining thoughtful design, modern technologies,
          and meaningful functionality.
        </p>
      </div>

      <a
        class="sx-all-projects"
        href="https://github.com/Jwayeye75"
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore All Projects
        <ArrowUpRight size={19} stroke-width={1.8} />
      </a>
    </div>

    <div class="sx-grid">
      {projects.map((project) => (
        <article class="sx-card">
          <div class="sx-card-top">
            <div class="sx-card-identity">
              <span class="sx-project-number">
                {project.number}
              </span>

              <span class="sx-project-category">
                {project.category}
              </span>
            </div>

            <a
              class="sx-card-arrow"
              href={project.live}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${project.name} website`}
            >
              <ArrowUpRight size={21} stroke-width={1.8} />
            </a>
          </div>

          <div class="sx-card-body">
            <h3>{project.name}</h3>

            <p class="sx-description">
              {project.description}
            </p>

            <div class="sx-stack">
              {project.technologies.map((technology) => (
                <span class="sx-tech">
                  {technology}
                </span>
              ))}
            </div>
          </div>

          <div class="sx-card-footer">
            <a
              class="sx-live-button"
              href={project.live}
              target="_blank"
              rel="noopener noreferrer"
            >
              <ExternalLink size={17} stroke-width={1.8} />
              <span>Live Website</span>
              <ArrowUpRight size={16} stroke-width={1.8} />
            </a>

            <a
              class="sx-github-button"
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Github size={19} />
              <span>Source Code</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="sx-bottom">
      <div class="sx-bottom-info">
        <span class="sx-bottom-number">05</span>
        <div>
          <strong>Featured Projects</strong>
          <span>And more in development</span>
        </div>
      </div>

      <a
        href="https://github.com/Jwayeye75"
        target="_blank"
        rel="noopener noreferrer"
        class="sx-bottom-link"
      >
        More on GitHub
        <ArrowRight size={19} stroke-width={1.8} />
      </a>
    </div>

  </div>
</section>

<style>
  .sx-work {
    background: #121212;
    padding: 110px 5%;
    color: #f8f6f3;
    font-family: "DM Sans", sans-serif;
  }

  .sx-container {
    width: 100%;
    max-width: 1340px;
    margin: 0 auto;
  }

  .sx-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 48px;
  }

  .sx-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 23px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2.7px;
    color: #ff762b;
  }

  .sx-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e95a19;
  }

  .sx-heading h2 {
    margin: 0;
    color: #ffffff;
    font-family: "Barlow Condensed", Impact, sans-serif;
    font-size: clamp(65px, 8vw, 110px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .sx-heading h2 span {
    color: #e95a19;
  }

  .sx-intro {
    max-width: 460px;
    margin: 24px 0 0;
    color: #aaa7a4;
    font-size: 14px;
    line-height: 1.9;
  }

  .sx-all-projects {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .sx-all-projects:hover {
    color: #ff762b;
  }

  /* PROJECT GRID */

  .sx-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .sx-card {
    min-width: 0;
    min-height: 345px;
    display: flex;
    flex-direction: column;
    padding: 29px;
    border: 1px solid #343434;
    border-radius: 20px;
    background: #1e1e1e;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .sx-card:hover {
    border-color: rgba(233, 90, 25, 0.8);
    transform: translateY(-5px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
  }

  .sx-card:last-child {
    grid-column: 1 / -1;
  }

  .sx-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 30px;
  }

  .sx-card-identity {
    display: flex;
    align-items: center;
    gap: 15px;
    min-width: 0;
  }

  .sx-project-number {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    color: #e95a19;
  }

  .sx-project-category {
    color: #a5a5a5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    line-height: 1.6;
  }

  .sx-card-arrow {
    width: 45px;
    height: 45px;
    flex: 0 0 45px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #292929;
    border: 1px solid #424242;
    color: #eee;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .sx-card:hover .sx-card-arrow {
    background: #e95a19;
    border-color: #e95a19;
    color: #fff;
  }

  .sx-card-body {
    flex: 1;
  }

  .sx-card-body h3 {
    margin: 0 0 14px;
    color: #fff;
    font-size: clamp(25px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.15;
  }

  .sx-description {
    max-width: 540px;
    margin: 0 0 23px;
    color: #aaa;
    font-size: 13px;
    line-height: 1.9;
  }

  .sx-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sx-tech {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    min-height: 31px;
    border: 1px solid #494949;
    border-radius: 100px;
    background: #252525;
    color: #d9d9d9;
    font-size: 10px;
    font-weight: 600;
    transition: border-color 0.25s ease;
  }

  .sx-card:hover .sx-tech {
    border-color: rgba(233, 90, 25, 0.5);
  }

  /* LINKS */

  .sx-card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 17px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid #393939;
  }

  .sx-live-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 11px;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 100px;
    background: #e95a19;
    color: white;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .sx-live-button:hover {
    background: #ff762b;
    transform: translateY(-2px);
  }

  .sx-github-button {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    font-size: 12px;
    font-weight: 700;
    color: #ddd;
    transition: color 0.2s ease;
  }

  .sx-github-button:hover {
    color: #ff762b;
  }

  /* BOTTOM */

  .sx-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 36px;
    padding: 28px 0;
    border-top: 1px solid #333;
  }

  .sx-bottom-info {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .sx-bottom-number {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 52px;
    font-weight: 800;
    line-height: 1;
    color: #e95a19;
  }

  .sx-bottom-info > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sx-bottom-info strong {
    font-size: 13px;
    font-weight: 800;
  }

  .sx-bottom-info div span {
    font-size: 11px;
    color: #999;
  }

  .sx-bottom-link {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    font-size: 12px;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .sx-bottom-link:hover {
    color: #ff762b;
  }

  /* MOBILE */

  @media (max-width: 760px) {
    .sx-work {
      padding: 76px 22px;
    }

    .sx-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 31px;
    }

    .sx-heading h2 {
      font-size: clamp(62px, 14vw, 90px);
    }

    .sx-intro {
      font-size: 13px;
      margin-top: 20px;
    }

    .sx-grid {
      grid-template-columns: 1fr;
      gap: 17px;
    }

    .sx-card,
    .sx-card:last-child {
      grid-column: auto;
    }

    .sx-card {
      padding: 23px;
      min-height: auto;
    }

    .sx-card-top {
      margin-bottom: 26px;
    }

    .sx-card-body h3 {
      font-size: 26px;
    }

    .sx-description {
      line-height: 1.8;
    }

    .sx-card-footer {
      margin-top: 26px;
    }

    .sx-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }

  @media (max-width: 380px) {
    .sx-work {
      padding-inline: 17px;
    }

    .sx-card {
      padding: 19px;
    }

    .sx-project-category {
      font-size: 9px;
    }

    .sx-live-button {
      padding-inline: 14px;
      gap: 8px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sx-card,
    .sx-card-arrow,
    .sx-tech,
    .sx-live-button {
      transition: none;
    }
  }
</style>
